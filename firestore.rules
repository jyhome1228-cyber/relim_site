rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == 'planus253@naver.com';
    }

    function validReviewFields() {
      return request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 60
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 5
        && request.resource.data.content.size() <= 2000
        && request.resource.data.imageDataUrl is string
        && request.resource.data.imageDataUrl.size() <= 850000;
    }

    function validReviewCreate() {
      return signedIn()
        && request.resource.data.userId == request.auth.uid
        && validReviewFields();
    }

    function validReviewOwnerUpdate() {
      return signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.userName == resource.data.userName
        && request.resource.data.createdAt == resource.data.createdAt
        && validReviewFields()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rating', 'title', 'content', 'imageDataUrl', 'updatedAt'
        ]);
    }

    match /users/{userId} {
      allow create, read, update: if isOwner(userId);
      allow delete: if false;

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if validReviewCreate();
      allow update: if validReviewOwnerUpdate();
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // 문의 게시판 공개 목록: 제목/구분/작성자/날짜/답변상태만 노출.
    match /inquiryIndex/{inquiryId} {
      allow read: if true;

      // 로그인 회원은 자기 UID로만 목록 항목을 만들 수 있다.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      // 작성자는 제목/구분만 수정, 관리자는 답변상태 갱신 가능.
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'category', 'title', 'updatedAt'
          ]));

      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // 실제 문의 내용과 관리자 답변: 작성자 본인과 관리자만 열람.
    match /inquiries/{inquiryId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      // 등록 시 본인 UID로만 작성 가능.
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      // 작성자는 문의 본문 관련 필드만 수정 가능. 답변/상태는 관리자만 수정.
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'category', 'title', 'content', 'updatedAt'
          ]));

      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
