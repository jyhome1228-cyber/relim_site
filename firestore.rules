rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == 'planus253@naver.com';
    }

    function validReviewFields() {
      return request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 60
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 5
        && request.resource.data.content.size() <= 2000
        && request.resource.data.imageDataUrl is string
        && request.resource.data.imageDataUrl.size() <= 850000;
    }

    function validReviewCreate() {
      return signedIn()
        && request.resource.data.userId == request.auth.uid
        && validReviewFields();
    }

    function validReviewOwnerUpdate() {
      return signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.userName == resource.data.userName
        && request.resource.data.createdAt == resource.data.createdAt
        && validReviewFields()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rating', 'title', 'content', 'imageDataUrl', 'updatedAt'
        ]);
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if validReviewCreate();
      allow update: if validReviewOwnerUpdate();
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // 새 문의게시판: 제목/구분/작성자/날짜/상태만 공개한다.
    match /questions/{questionId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if isAdmin()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'category', 'title', 'updatedAt'
          ]));

      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      // 문의 본문과 관리자 답변은 작성자와 관리자만 열람한다.
      match /private/{privateId} {
        allow read: if isAdmin()
          || (signedIn() && resource.data.ownerUid == request.auth.uid);

        allow create: if signedIn()
          && request.resource.data.ownerUid == request.auth.uid;

        allow update: if isAdmin()
          || (signedIn()
            && resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'content', 'updatedAt'
            ]));

        allow delete: if isAdmin()
          || (signedIn() && resource.data.ownerUid == request.auth.uid);
      }
    }

    // 방문 통계는 사이트에서 +1 증가만 허용하고, 조회는 관리자에게만 허용한다.
    match /trafficDays/{dayId} {
      allow read: if isAdmin();

      allow create: if dayId.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.keys().hasOnly(['dayKey', 'count', 'updatedAt'])
        && request.resource.data.dayKey == dayId
        && request.resource.data.count == 1
        && request.resource.data.updatedAt is timestamp;

      allow update: if dayId.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && resource.data.dayKey == dayId
        && request.resource.data.dayKey == resource.data.dayKey
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt']);

      allow delete: if false;
    }

    match /trafficSummary/{summaryId} {
      allow read: if isAdmin();

      allow create: if summaryId == 'total'
        && request.resource.data.keys().hasOnly(['scope', 'count', 'updatedAt'])
        && request.resource.data.scope == 'total'
        && request.resource.data.count == 1
        && request.resource.data.updatedAt is timestamp;

      allow update: if summaryId == 'total'
        && resource.data.scope == 'total'
        && request.resource.data.scope == resource.data.scope
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt']);

      allow delete: if false;
    }

    // 이전 문의 구조는 마이그레이션 전 데이터 보호를 위해 비공개 유지.
    match /inquiryIndex/{inquiryId} {
      allow read: if true;
      allow write: if false;
    }

    match /inquiries/{inquiryId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
