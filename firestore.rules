rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email in ['planus253@naver.com', 'penury@naver.com'];
    }

    // 사이트 CMS: 공개 사이트는 읽기만, 수정은 관리자만 허용한다.
    match /siteConfig/{configId} {
      allow read: if configId == 'public';
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // 리뷰 기능은 사이트 운영 범위에서 제외한다.
    match /reviews/{reviewId} {
      allow read, write: if false;
    }

    // 문의게시판: 제목/구분/작성자/날짜/상태만 공개한다.
    match /questions/{questionId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if isAdmin()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'category', 'title', 'updatedAt'
          ]));

      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      // 문의 본문과 관리자 답변은 작성자와 관리자만 열람한다.
      match /private/{privateId} {
        allow read: if isAdmin()
          || (signedIn() && resource.data.ownerUid == request.auth.uid);

        allow create: if signedIn()
          && request.resource.data.ownerUid == request.auth.uid;

        allow update: if isAdmin()
          || (signedIn()
            && resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'content', 'updatedAt'
            ]));

        allow delete: if isAdmin()
          || (signedIn() && resource.data.ownerUid == request.auth.uid);
      }
    }

    // 방문 통계는 사이트에서 +1 증가만 허용하고, 조회는 관리자에게만 허용한다.
    match /trafficDays/{dayId} {
      allow read: if isAdmin();

      allow create: if dayId.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.keys().hasOnly(['dayKey', 'count', 'updatedAt'])
        && request.resource.data.dayKey == dayId
        && request.resource.data.count == 1
        && request.resource.data.updatedAt is timestamp;

      allow update: if dayId.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && resource.data.dayKey == dayId
        && request.resource.data.dayKey == resource.data.dayKey
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt']);

      allow delete: if false;
    }

    match /trafficSummary/{summaryId} {
      allow read: if isAdmin();

      allow create: if summaryId == 'total'
        && request.resource.data.keys().hasOnly(['scope', 'count', 'updatedAt'])
        && request.resource.data.scope == 'total'
        && request.resource.data.count == 1
        && request.resource.data.updatedAt is timestamp;

      allow update: if summaryId == 'total'
        && resource.data.scope == 'total'
        && request.resource.data.scope == resource.data.scope
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt']);

      allow delete: if false;
    }

    // 유입경로는 개인식별정보 없이 일자/소스/랜딩 단위로 집계한다.
    match /trafficAttribution/{entryId} {
      allow read: if isAdmin();

      allow create: if entryId.matches('^\\d{4}-\\d{2}-\\d{2}_[0-9a-f]{16}$')
        && request.resource.data.keys().hasOnly([
          'dayKey', 'channel', 'source', 'medium', 'campaign', 'referrerHost',
          'landingPath', 'device', 'browser', 'count', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.dayKey is string
        && request.resource.data.dayKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.channel is string
        && request.resource.data.channel.size() <= 40
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 100
        && request.resource.data.medium is string
        && request.resource.data.medium.size() <= 80
        && request.resource.data.campaign is string
        && request.resource.data.campaign.size() <= 120
        && request.resource.data.referrerHost is string
        && request.resource.data.referrerHost.size() <= 140
        && request.resource.data.landingPath is string
        && request.resource.data.landingPath.size() <= 240
        && request.resource.data.device is string
        && request.resource.data.device.size() <= 20
        && request.resource.data.browser is string
        && request.resource.data.browser.size() <= 40
        && request.resource.data.count == 1
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if entryId.matches('^\\d{4}-\\d{2}-\\d{2}_[0-9a-f]{16}$')
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt']);

      allow delete: if false;
    }

    // 이전 문의 구조는 마이그레이션 전 데이터 보호를 위해 비공개 유지.
    match /inquiryIndex/{inquiryId} {
      allow read: if true;
      allow write: if false;
    }

    match /inquiries/{inquiryId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
