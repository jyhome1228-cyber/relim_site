rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == 'planus253@naver.com';
    }

    function validReviewFields() {
      return request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 60
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 5
        && request.resource.data.content.size() <= 2000
        && request.resource.data.imageDataUrl is string
        && request.resource.data.imageDataUrl.size() <= 850000;
    }

    function validReviewCreate() {
      return signedIn()
        && request.resource.data.userId == request.auth.uid
        && validReviewFields();
    }

    function validReviewOwnerUpdate() {
      return signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.userName == resource.data.userName
        && request.resource.data.createdAt == resource.data.createdAt
        && validReviewFields()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rating', 'title', 'content', 'imageDataUrl', 'updatedAt'
        ]);
    }

    function validInquiryFields() {
      return request.resource.data.category is string
        && request.resource.data.category.size() >= 2
        && request.resource.data.category.size() <= 30
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 80
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 5
        && request.resource.data.content.size() <= 3000;
    }

    function validInquiryCreate() {
      return signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.status == '답변대기'
        && validInquiryFields();
    }

    function validInquiryOwnerUpdate() {
      return signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.userName == resource.data.userName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status == resource.data.status
        && validInquiryFields()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'category', 'title', 'content', 'updatedAt'
        ]);
    }

    function validInquiryIndexCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'userName', 'category', 'title', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.category is string
        && request.resource.data.category.size() >= 2
        && request.resource.data.category.size() <= 30
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 80
        && request.resource.data.status == '답변대기';
    }

    function validInquiryIndexOwnerUpdate() {
      return signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.userName == resource.data.userName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status == resource.data.status
        && request.resource.data.category is string
        && request.resource.data.title is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'category', 'title', 'updatedAt'
        ]);
    }

    match /users/{userId} {
      allow create, read, update: if isOwner(userId);
      allow delete: if false;

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // 리뷰: 누구나 열람, 로그인 회원 작성, 작성자 본인만 수정/삭제.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if validReviewCreate();
      allow update: if validReviewOwnerUpdate();
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // 문의 게시판에 노출되는 공개 목록 데이터.
    // 제목/구분/마스킹된 작성자/작성일/답변상태만 담고 본문과 답변은 저장하지 않는다.
    match /inquiryIndex/{inquiryId} {
      allow read: if true;
      allow create: if validInquiryIndexCreate();
      allow update: if isAdmin() || validInquiryIndexOwnerUpdate();
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // 실제 문의 본문과 관리자 답변.
    // 작성자 본인과 관리자만 읽을 수 있어 다른 회원에게 내용/답변이 노출되지 않는다.
    match /inquiries/{inquiryId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if validInquiryCreate();
      allow update: if isAdmin() || validInquiryOwnerUpdate();
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
